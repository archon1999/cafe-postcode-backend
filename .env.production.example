# Use with: docker compose --env-file .env.production up -d --build
SECRET_KEY=replace-with-at-least-50-random-characters-from-a-secret-manager
POSTGRES_DB=cafe_postcode
POSTGRES_USER=cafe_postcode
POSTGRES_PASSWORD=replace-with-a-strong-database-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

ALLOWED_HOSTS=cafe-postcode.uz,www.cafe-postcode.uz,web
CSRF_TRUSTED_ORIGINS=https://cafe-postcode.uz,https://www.cafe-postcode.uz
CORS_ALLOWED_ORIGINS=https://cafe-postcode.uz,https://www.cafe-postcode.uz

HTTP_BIND=127.0.0.1
HTTP_PORT=8880
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=https://cafe-postcode.uz/grafana/

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
Q_CLUSTER_WORKERS=8
LOG_LEVEL=INFO

# Landing-page leads are delivered to Telegram by the backend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
TELEGRAM_TIMEOUT=10
TELEGRAM_PROXY_URL=
ADMIN_AUTH_SESSION_TTL_SECONDS=86400
POS_AUTH_SESSION_TTL_SECONDS=86400
DASHBOARD_AUTH_SESSION_TTL_SECONDS=86400

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=cpython
AWS_S3_MEDIA_PREFIX=media/cafe-postcode
AWS_S3_CUSTOM_DOMAIN=
LOCAL_AGENT_RELEASE_MANIFEST_URL=https://admin.cafe-postcode.uz/downloads/local-agent-release.json

# For local HTTP-only smoke tests, temporarily set these three values to 0.
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_PRELOAD=1
LOCAL_AGENT_ALLOW_LEGACY_WS_QUERY_TOKEN=0
