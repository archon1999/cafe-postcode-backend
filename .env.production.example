# Follow ops/DEVICE_MIGRATION_RUNBOOK.md; do not start production with a direct
# `docker compose up` before backup, role provisioning, and migrations succeed.
SECRET_KEY=replace-with-at-least-50-random-characters-from-a-secret-manager
POSTGRES_DB=cafe_postcode
POSTGRES_USER=cafe_postcode
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Runtime containers must never use POSTGRES_USER. Provision these least-privilege
# roles with ops/provision-database-roles.sh before the first secured rollout.
DB_APP_USER=cafe_postcode_app
DB_APP_PASSWORD=replace-with-a-different-strong-runtime-password
DB_MONITOR_USER=cafe_postcode_monitor
# postgres-exporter consumes a URI, so generate a long URL-safe value.
DB_MONITOR_PASSWORD=replace-with-a-long-url-safe-monitor-password
MIGRATION_LOCK_TIMEOUT=5s
MIGRATION_STATEMENT_TIMEOUT=15min
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

ALLOWED_HOSTS=cafe-postcode.uz,www.cafe-postcode.uz,web
CSRF_TRUSTED_ORIGINS=https://cafe-postcode.uz,https://www.cafe-postcode.uz,https://control.cafe-postcode.uz
CORS_ALLOWED_ORIGINS=https://cafe-postcode.uz,https://www.cafe-postcode.uz,https://control.cafe-postcode.uz

HTTP_BIND=127.0.0.1
HTTP_PORT=8880
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=https://cafe-postcode.uz/grafana/

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
Q_CLUSTER_WORKERS=8
LOG_LEVEL=INFO

# Landing-page leads are delivered to Telegram by the backend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
TELEGRAM_TIMEOUT=10
TELEGRAM_PROXY_URL=
YANDEX_TRANSLATE_API_KEY=
YANDEX_TRANSLATE_FOLDER_ID=
YANDEX_TRANSLATE_TIMEOUT=10
# Faktura.uz company lookup. Compose exposes these values only to the web service.
FAKTURA_TOKEN_URL=https://account.faktura.uz/token
FAKTURA_API_BASE_URL=https://api.faktura.uz
FAKTURA_USERNAME=
FAKTURA_PASSWORD=
FAKTURA_CLIENT_ID=
FAKTURA_CLIENT_SECRET=
FAKTURA_TIMEOUT=10
FAKTURA_PROXY_URL=
# Owner-facing sales report bot. Keep this token separate from the leads bot.
TELEGRAM_REPORTS_BOT_TOKEN=
TELEGRAM_REPORTS_WEBHOOK_SECRET=replace-with-a-random-secret
TELEGRAM_REPORTS_WEBHOOK_URL=https://cafe-postcode.uz/api/v1/telegram-reports/webhook/
ADMIN_AUTH_SESSION_TTL_SECONDS=900
ADMIN_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
ADMIN_IDLE_LOCK_SECONDS=0
ADMIN_AUTH_ALLOWED_ORIGINS=https://admin.cafe-postcode.uz,https://control.cafe-postcode.uz
# Generate each key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_MFA_FERNET_KEYS=replace-with-a-dedicated-fernet-key
ADMIN_MFA_REQUIRED=0
# Comma-separated, primary key first. Keep old keys until
# `python manage.py rotate_integration_settings_keys` completes successfully.
INTEGRATION_FERNET_KEYS=replace-with-a-separate-dedicated-fernet-key
# Keep Django's built-in admin off. To enable it, set an explicit VPN CIDR
# allowlist and list only reverse proxies that overwrite X-Forwarded-For.
DJANGO_ADMIN_ENABLED=0
DJANGO_ADMIN_ALLOWED_CIDRS=
DJANGO_ADMIN_TRUSTED_PROXY_CIDRS=
# Replace with the exact backend-facing host/Docker gateway addresses.
CLIENT_IP_TRUSTED_PROXY_CIDRS=127.0.0.1/32
POS_AUTH_SESSION_TTL_SECONDS=86400
DASHBOARD_AUTH_SESSION_TTL_SECONDS=86400

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=cpython
AWS_S3_MEDIA_PREFIX=media/cafe-postcode
AWS_S3_CUSTOM_DOMAIN=
LOCAL_AGENT_RELEASE_MANIFEST_URL=https://admin.cafe-postcode.uz/downloads/local-agent-release.json

# For local HTTP-only smoke tests, temporarily set these three values to 0.
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_PRELOAD=1

# Device-auth rollout. Phase 1 silently migrates existing trusted sessions and
# agents. After the migration dashboard reaches zero legacy devices, require
# proofs and disable all migration switches.
DEVICE_PAIRING_CLAIM_BASE_URL=https://control.cafe-postcode.uz/pair
DEVICE_POS_PROOF_REQUIRED=1
DEVICE_LEGACY_POS_MIGRATION_ENABLED=1
# Lets already-issued pre-deploy sessions finish during the bounded rollout;
# new PIN logins still require device proof from the first production request.
DEVICE_LEGACY_POS_SESSION_AUTH_ENABLED=1
DEVICE_LEGACY_LOCAL_AGENT_MIGRATION_ENABLED=1
DEVICE_LEGACY_LOCAL_AGENT_AUTH_ENABLED=1
DEVICE_LEGACY_TV_PAIRING_ENABLED=0
DEVICE_LEGACY_TV_MIGRATION_ENABLED=1
# Required while any legacy flag is enabled or POS proof is disabled. The
# application opens at STARTED_AT and closes at DEADLINE (max 24 hours).
# For the planned cutover use 2026-08-19T19:30:00Z through 2026-08-20T19:30:00Z.
DEVICE_LEGACY_MIGRATION_STARTED_AT=
DEVICE_LEGACY_MIGRATION_DEADLINE=
# Security audit records are retained for six months; completed/expired
# pairing requests contain no reusable plaintext secret and are kept 30 days.
SECURITY_EVENT_RETENTION_DAYS=180
DEVICE_PAIRING_RETENTION_DAYS=30
