msgstr "Юкланган файл жуда катта."

msgid "Internal server error"
msgstr "Ички сервер хатоси"

msgid "PIN code must be a string."
msgstr "PIN-код сатр бўлиши керак."

msgid "PIN code must contain only digits."
msgstr "PIN-код фақат рақамлардан иборат бўлиши керак."

msgid "Invalid PIN code."
msgstr "Нотўғри PIN-код."

msgid "This PIN code is assigned to multiple POS users. Use unique PIN codes."
msgstr ""
"Бу PIN-код бир нечта POS фойдаланувчига бириктирилган. Ягона PIN-кодлардан "
"фойдаланинг."

msgid "This PIN code is already assigned to another POS user."
msgstr "Бу PIN-код аллақачон бошқа POS фойдаланувчига бириктирилган."

msgid "Invalid credentials."
msgstr "Нотўғри кириш маълумотлари."

msgid "User is not allowed in admin UI."
msgstr "Фойдаланувчига админ интерфейсга кириш рухсат этилмаган."

msgid "Only 2, 3, 4, 5, or 6 seat tables are supported."
msgstr "Фақат 2, 3, 4, 5 ёки 6 ўринли столлар қўллаб-қувватланади."

msgid "Shape variant does not match the selected seat count."
msgstr "Shape варианти танланган ўринлар сонига мос эмас."

msgid "Selected table does not belong to the selected hall."
msgstr "Танланган стол танланган залга тегишли эмас."

msgid "System roles cannot be deleted."
msgstr "Тизим ролларини ўчириб бўлмайди."

msgid "This table already has an active session."
msgstr "Бу столда аллақачон фаол сессия мавжуд."

msgid "Guest count cannot exceed this table limit (%(limit)s)."
msgstr "Меҳмонлар сони ушбу стол лимити (%(limit)s)дан ошмаслиги керак."

msgid "One or more tables do not belong to this hall."
msgstr "Бир ёки бир нечта стол ушбу залга тегишли эмас."

msgid "The same table cannot be updated and deleted at the same time."
msgstr "Бир столни бир вақтнинг ўзида янгилаб ҳам, ўчириб ҳам бўлмайди."

msgid "Full hall snapshot is required when saving constructor data."
msgstr "Конструктор маълумотини сақлаш учун залнинг тўлиқ snapshotи керак."

msgid "Table numbers must be unique inside a hall."
msgstr "Стол рақамлари зал ичида ягона бўлиши керак."

msgid "One or more tables exceed the configured grid width."
msgstr "Бир ёки бир нечта стол белгиланган grid кенглигидан ошиб кетган."

msgid "Tables cannot overlap inside the hall constructor grid."
msgstr "Столлар зал конструктори gridида устма-уст жойлаша олмайди."

msgid "Cannot merge a session into itself."
msgstr "Сессияни ўзига бирлаштириб бўлмайди."

msgid "Target table already has an active session."
msgstr "Мақсад столида аллақачон фаол сессия мавжуд."

msgid "Kitchen module is disabled for this restaurant."
msgstr "Ушбу ресторанда ошхона модули ўчирилган."

msgid "Kitchen display actions are disabled in printer mode."
msgstr "Printer режимида ошхона display амаллари ўчирилган."

msgid "Invalid status."
msgstr "Нотўғри ҳолат."

msgid "This menu item is inactive."
msgstr "Бу меню элементи фаол эмас."

msgid "This menu item is in stoplist."
msgstr "Бу меню элементи stop-listда."

msgid "Payment amount must be greater than zero."
msgstr "Тўлов суммаси нолдан катта бўлиши керак."

msgid "Payment amount must cover the full remaining total."
msgstr "Тўлов суммаси қолган жами суммани тўлиқ қоплаши керак."

msgid "Order has no items."
msgstr "Буюртмада маҳсулот йўқ."

msgid "This table session already has an active order."
msgstr "Бу стол сессиясида аллақачон фаол буюртма мавжуд."
