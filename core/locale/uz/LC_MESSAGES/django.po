msgstr "Ichki server xatosi"

msgid "PIN code must be a string."
msgstr "PIN-kod satr bo'lishi kerak."

msgid "PIN code must contain only digits."
msgstr "PIN-kod faqat raqamlardan iborat bo'lishi kerak."

msgid "Invalid PIN code."
msgstr "Noto'g'ri PIN-kod."

msgid "This PIN code is assigned to multiple POS users. Use unique PIN codes."
msgstr ""
"Bu PIN-kod bir nechta POS foydalanuvchiga biriktirilgan. Yagona PIN-"
"kodlardan foydalaning."

msgid "This PIN code is already assigned to another POS user."
msgstr "Bu PIN-kod allaqachon boshqa POS foydalanuvchiga biriktirilgan."

msgid "Invalid credentials."
msgstr "Noto'g'ri kirish ma'lumotlari."

msgid "User is not allowed in admin UI."
msgstr "Foydalanuvchiga admin interfeysga kirish ruxsat etilmagan."

msgid "Only 2, 3, 4, 5, or 6 seat tables are supported."
msgstr "Faqat 2, 3, 4, 5 yoki 6 o'rinli stollar qo'llab-quvvatlanadi."

msgid "Shape variant does not match the selected seat count."
msgstr "Shape varianti tanlangan o'rinlar soniga mos emas."

msgid "Selected table does not belong to the selected hall."
msgstr "Tanlangan stol tanlangan zalga tegishli emas."

msgid "System roles cannot be deleted."
msgstr "Tizim rollarini o'chirib bo'lmaydi."

msgid "This table already has an active session."
msgstr "Bu stolda allaqachon faol sessiya mavjud."

msgid "Guest count cannot exceed this table limit (%(limit)s)."
msgstr "Mehmonlar soni ushbu stol limiti (%(limit)s)dan oshmasligi kerak."

msgid "One or more tables do not belong to this hall."
msgstr "Bir yoki bir nechta stol ushbu zalga tegishli emas."

msgid "The same table cannot be updated and deleted at the same time."
msgstr "Bir stolni bir vaqtning o'zida yangilab ham, o'chirib ham bo'lmaydi."

msgid "Full hall snapshot is required when saving constructor data."
msgstr "Konstruktor ma'lumotini saqlash uchun zalning to'liq snapshoti kerak."

msgid "Table numbers must be unique inside a hall."
msgstr "Stol raqamlari zal ichida yagona bo'lishi kerak."

msgid "One or more tables exceed the configured grid width."
msgstr "Bir yoki bir nechta stol belgilangan grid kengligidan oshib ketgan."

msgid "Tables cannot overlap inside the hall constructor grid."
msgstr "Stollar zal konstruktori gridida ustma-ust joylasha olmaydi."

msgid "Cannot merge a session into itself."
msgstr "Sessiyani o'ziga birlashtirib bo'lmaydi."

msgid "Target table already has an active session."
msgstr "Maqsad stolida allaqachon faol sessiya mavjud."

msgid "Kitchen module is disabled for this restaurant."
msgstr "Ushbu restoranda oshxona moduli o'chirilgan."

msgid "Kitchen display actions are disabled in printer mode."
msgstr "Printer rejimida oshxona display amallari o'chirilgan."

msgid "Invalid status."
msgstr "Noto'g'ri holat."

msgid "This menu item is inactive."
msgstr "Bu menyu elementi faol emas."

msgid "This menu item is in stoplist."
msgstr "Bu menyu elementi stop-listda."

msgid "Payment amount must be greater than zero."
msgstr "To'lov summasi noldan katta bo'lishi kerak."

msgid "Payment amount must cover the full remaining total."
msgstr "To'lov summasi qolgan jami summani to'liq qoplashi kerak."

msgid "Order has no items."
msgstr "Buyurtmada mahsulot yo'q."

msgid "This table session already has an active order."
msgstr "Bu stol sessiyasida allaqachon faol buyurtma mavjud."

