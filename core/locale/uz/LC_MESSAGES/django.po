msgid "Top consecutive accepts — %(name)s with %(count)d in a row."
msgstr "Eng ko‘p ketma-ket AC — %(name)s, %(count)d ta ketma-ket."

msgid "Perfect accuracy — %(name)s solved %(solved)d problems without wrong attempts."
msgstr "Ideal aniqlik — %(name)s %(solved)d ta masalani xatosiz yechdi."

msgid "Most diverse problem attempts — %(name)s worked on %(count)d problems."
msgstr "Eng ko‘p turli masalaga urinish — %(name)s %(count)d ta masala ustida ishladi."

msgid "%(percentage)d%% of attempts happened within the first hour."
msgstr "Urinishlarning %(percentage)d%% birinchi soatda amalga oshirildi."

msgid "%(percentage)d%% of accepted submissions happened within the first two hours."
msgstr "Qabul qilingan submitlarning %(percentage)d%% birinchi ikki soatda paydo bo‘ldi."

msgid "%(share)d%% of all attempts targeted problem %(symbol)s."
msgstr "Urinishlarning %(share)d%% faqat %(symbol)s masalasiga to‘g‘ri keldi."

msgid "The last submission was sent %(duration)s before the contest ended."
msgstr "Eng so‘nggi submit kontest tugashidan %(duration)s oldin yuborildi."

msgid "The last submission was sent %(duration)s after the contest ended."
msgstr "Eng so‘nggi submit kontest tugagandan %(duration)s keyin yuborildi."

msgid "%(name)s solved problem %(symbol)s after %(count)d attempts."
msgstr "%(name)s %(symbol)s masalasini %(count)d ta urinishdan so‘ng yechdi."

msgid "%(count)d participants submitted at least once."
msgstr "Jami %(count)d nafar ishtirokchi kamida bir marta submit yubordi."

msgid "Overall acceptance rate was %(percentage).2f%%."
msgstr "Umumiy qabul qilish darajasi %(percentage).2f%% bo‘ldi."

