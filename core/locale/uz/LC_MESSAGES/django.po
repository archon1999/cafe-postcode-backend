msgid "Problem %(symbol)s was the toughest — %(attempts)d attempts with %(accepted)d accepted."
msgstr "Masala %(symbol)s eng qiyin bo‘ldi — %(attempts)d ta urinishdan faqat %(accepted)d tasi qabul qilindi."

msgid "Problem %(symbol)s was the toughest — %(attempts)d attempts without an accepted solution."
