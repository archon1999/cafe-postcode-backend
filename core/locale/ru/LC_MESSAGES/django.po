msgid "PIN code must be a string."
msgstr "PIN-код должен быть строкой."

msgid "PIN code must contain only digits."
msgstr "PIN-код должен содержать только цифры."

msgid "Invalid PIN code."
msgstr "Неверный PIN-код."

msgid "This PIN code is assigned to multiple POS users. Use unique PIN codes."
msgstr ""
"Этот PIN-код назначен нескольким POS-пользователям. Используйте уникальные "
"PIN-коды."

msgid "This PIN code is already assigned to another POS user."
msgstr "Этот PIN-код уже назначен другому POS-пользователю."

msgid "Invalid credentials."
msgstr "Неверные учетные данные."

msgid "User is not allowed in admin UI."
msgstr "Пользователю запрещен доступ в админ-интерфейс."

msgid "Only 2, 3, 4, 5, or 6 seat tables are supported."
msgstr "Поддерживаются только столы на 2, 3, 4, 5 или 6 мест."

msgid "Shape variant does not match the selected seat count."
msgstr "Вариант формы не соответствует выбранному количеству мест."

msgid "Selected table does not belong to the selected hall."
msgstr "Выбранный стол не принадлежит выбранному залу."

msgid "System roles cannot be deleted."
msgstr "Системные роли нельзя удалить."

msgid "This table already has an active session."
msgstr "У этого стола уже есть активная сессия."

msgid "Guest count cannot exceed this table limit (%(limit)s)."
msgstr "Количество гостей не может превышать лимит этого стола (%(limit)s)."

msgid "One or more tables do not belong to this hall."
msgstr "Один или несколько столов не принадлежат этому залу."

msgid "The same table cannot be updated and deleted at the same time."
msgstr "Один и тот же стол нельзя одновременно обновлять и удалять."

msgid "Full hall snapshot is required when saving constructor data."
msgstr "Для сохранения данных конструктора требуется полный снимок зала."

msgid "Table numbers must be unique inside a hall."
msgstr "Номера столов должны быть уникальными внутри зала."

msgid "One or more tables exceed the configured grid width."
msgstr ""
"Один или несколько столов выходят за пределы настроенной ширины сетки."

msgid "Tables cannot overlap inside the hall constructor grid."
msgstr "Столы не могут пересекаться внутри сетки конструктора зала."

msgid "Cannot merge a session into itself."
msgstr "Нельзя объединить сессию саму в себя."

msgid "Target table already has an active session."
msgstr "На целевом столе уже есть активная сессия."

msgid "Kitchen module is disabled for this restaurant."
msgstr "Модуль кухни отключен для этого ресторана."

msgid "Kitchen display actions are disabled in printer mode."
msgstr "Действия кухонного дисплея отключены в режиме принтера."

msgid "Invalid status."
msgstr "Некорректный статус."

msgid "This menu item is inactive."
msgstr "Эта позиция меню неактивна."

msgid "This menu item is in stoplist."
msgstr "Эта позиция меню находится в стоп-листе."

msgid "Payment amount must be greater than zero."
msgstr "Сумма оплаты должна быть больше нуля."

msgid "Payment amount must cover the full remaining total."
msgstr "Сумма оплаты должна полностью покрывать оставшийся итог."

msgid "Order has no items."
msgstr "В заказе нет позиций."

msgid "This table session already has an active order."
msgstr "У этой сессии стола уже есть активный заказ."

