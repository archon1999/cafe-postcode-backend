# MCP-only runtime: build tooling and OS administration programs never ship.
FROM python:3.12-slim AS builder
ENV POETRY_NO_INTERACTION=1 POETRY_VIRTUALENVS_CREATE=false
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && pip install --no-cache-dir poetry==2.3.3 \
    && python -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH
COPY pyproject.toml poetry.lock ./
RUN poetry install --only main --no-root --no-ansi

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH
WORKDIR /app
# The service runs only Python as an unprivileged user. It has no shell-based
# entrypoint and needs no mount, login, Perl, terminal UI or package manager.
# Remove unused packages rather than excluding their findings from the scan.
RUN apt-get update && apt-get upgrade -y \
    && apt-get purge -y --allow-remove-essential \
      bsdutils mount util-linux login liblastlog2-2 libmount1 libblkid1 \
      libsmartcols1 libuuid1 libsystemd0 libudev1 libacl1 \
      libncursesw6 libtinfo6 ncurses-base ncurses-bin perl-base \
    && python -c 'import shutil; shutil.rmtree("/var/lib/apt/lists",ignore_errors=True); shutil.rmtree("/var/cache/apt",ignore_errors=True)'
COPY --from=builder /opt/venv /opt/venv
COPY --chown=65532:65532 . .
RUN python ops/compile_translations.py \
    && python -c 'import django, psycopg2, ssl, sqlite3, uuid, mcp; print("Runtime imports verified")'
USER 65532:65532
EXPOSE 8765
CMD ["uvicorn", "core.mcp_asgi:application", "--host", "0.0.0.0", "--port", "8765", "--no-access-log", "--no-proxy-headers"]

